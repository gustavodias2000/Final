# Nunca inclua valores reais de produção neste arquivo.
ENVIRONMENT=development
PROJECT_NAME=Auditor NCM SaaS
SECRET_KEY=substitua-por-um-segredo-longo-e-aleatorio
DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/auditor
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=60
SISCOMEX_NCM_URL=https://portalunico.siscomex.gov.br/classif/api/publico/nomenclatura/download/json
CEST_LOOKUP_URL_TEMPLATE=https://codigocest.com.br/index.php?ncm={ncm}
# Ative somente depois de validar a fonte e a frequência de consulta permitida.
CEST_LOOKUP_ENABLED=false
# Limite de NCMs distintos consultados por auditoria para evitar scraping descontrolado.
CEST_LOOKUP_MAX_UNIQUE_NCMS=250
# Cadeia API: Tabelas Fiscais -> NCM.api.br -> revisão AZX -> catálogo local/Siscomex.
# Desligada até que a equipe valide limites e chaves das fontes.
EXTERNAL_REFERENCE_LOOKUP_ENABLED=false
EXTERNAL_REFERENCE_LOOKUP_MAX_UNIQUE_NCMS=100
EXTERNAL_REFERENCE_RETRY_SECONDS=70
EXTERNAL_REFERENCE_FULL_RETRY_SECONDS=120
EXTERNAL_REFERENCE_MAX_CYCLES=3
TABELAS_FISCAIS_API_BASE_URL=https://tabelasfiscais.com.br/api/v1
NCM_API_BASE_URL=https://apincm-kb2xbt7jka-rj.a.run.app/v1
NCM_API_KEY=
EXTERNAL_REQUEST_TIMEOUT_SECONDS=15
CEST_CACHE_TTL_SECONDS=86400
# Seleção determinística entre múltiplos CESTs da mesma NCM; sempre exige revisão humana.
CEST_CANDIDATE_SCORE_THRESHOLD=85
CEST_CANDIDATE_SCORE_MARGIN=12
MAX_UPLOAD_BYTES=10485760
AUDIT_WORKER_POLL_INTERVAL_SECONDS=2
AUDIT_WORKER_LEASE_SECONDS=120
AUDIT_WORKER_MAX_ATTEMPTS=3
AUDIT_WORKER_PROGRESS_BATCH_SIZE=100
